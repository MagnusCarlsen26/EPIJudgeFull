# Copy this file to judge0.conf for local development.

JUDGE0_TELEMETRY_ENABLE=false
ENABLE_WAIT_RESULT=true
ENABLE_ADDITIONAL_FILES=true
USE_DOCS_AS_HOMEPAGE=true

ALLOW_ORIGIN=
ALLOW_IP=

# Leave empty for local-only development. If you set AUTHN_TOKEN, also set
# backend JUDGE0_AUTH_TOKEN to the same value.
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=change-me-postgres-password

CPU_TIME_LIMIT=5
MAX_CPU_TIME_LIMIT=15
WALL_TIME_LIMIT=10
MAX_WALL_TIME_LIMIT=30
MEMORY_LIMIT=262144
MAX_MEMORY_LIMIT=524288
MAX_FILE_SIZE=200000
MAX_MAX_FILE_SIZE=200000
MAX_EXTRACT_SIZE=200000
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false

RAILS_ENV=production
SECRET_KEY_BASE=change-me-secret-key-base
